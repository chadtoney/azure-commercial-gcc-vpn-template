# Site-to-Site VPN Deployment Configuration
# Copy this file to .env and fill in your actual values
# .env is not committed to git and will be ignored

# ============================================================================
# COMMERCIAL ENVIRONMENT
# ============================================================================

# Azure subscription details
COMMERCIAL_SUBSCRIPTION_ID = "PASTE_YOUR_COMMERCIAL_SUBSCRIPTION_ID_HERE"
COMMERCIAL_TENANT_ID = "PASTE_YOUR_COMMERCIAL_TENANT_ID_HERE"
COMMERCIAL_RESOURCE_GROUP = "PASTE_YOUR_COMMERCIAL_RG_NAME_HERE"
COMMERCIAL_REGION = "eastus2"

# Networking configuration
COMMERCIAL_ADDRESS_PREFIX = "10.10.0.0/16"
COMMERCIAL_GATEWAY_SUBNET = "10.10.255.0/27"
COMMERCIAL_WORKLOAD_SUBNET = "10.10.1.0/24"

# VPN settings
COMMERCIAL_GATEWAY_SKU = "VpnGw2AZ"
COMMERCIAL_REMOTE_GATEWAY_IP = "PASTE_GCC_GATEWAY_PUBLIC_IP_HERE"
COMMERCIAL_REMOTE_ADDRESS_PREFIX = "10.20.0.0/16"

# ============================================================================
# GCC ENVIRONMENT
# ============================================================================

# Azure subscription details
GCC_SUBSCRIPTION_ID = "PASTE_YOUR_GCC_SUBSCRIPTION_ID_HERE"
GCC_TENANT_ID = "PASTE_YOUR_GCC_TENANT_ID_HERE"
GCC_RESOURCE_GROUP = "PASTE_YOUR_GCC_RG_NAME_HERE"
GCC_REGION = "usgovvirginia"

# Networking configuration
GCC_ADDRESS_PREFIX = "10.20.0.0/16"
GCC_GATEWAY_SUBNET = "10.20.255.0/27"
GCC_WORKLOAD_SUBNET = "10.20.1.0/24"

# VPN settings
GCC_GATEWAY_SKU = "VpnGw2AZ"
GCC_REMOTE_GATEWAY_IP = "PASTE_COMMERCIAL_GATEWAY_PUBLIC_IP_HERE"
GCC_REMOTE_ADDRESS_PREFIX = "10.10.0.0/16"

# ============================================================================
# SHARED VPN CONFIGURATION
# ============================================================================

# Pre-shared key for IPsec authentication (treat as a secret)
SHARED_KEY = "PASTE_YOUR_SECURE_PRESHARED_KEY_HERE"

# Resource naming prefix (used for all resource names)
NAMING_PREFIX = "crosscloud"

# Create Key Vault for secrets storage (true/false)
CREATE_KEY_VAULT = "true"

# ============================================================================
# NOTES
# ============================================================================
# - Do not commit .env to git (already in .gitignore)
# - Keep SHARED_KEY secure; consider storing in your CI/CD secrets instead
# - Address prefixes must NOT overlap between Commercial and GCC
# - Gateway public IPs will be generated after first deployment
# - Update REMOTE_GATEWAY_IP values after first deployment completes
